# 视频项目只收录 output 顶层的最终成片；shared 保留源码。
# 放在通用忽略规则之前，避免放行 shared 下的依赖、密钥或缓存。
/script/**
!/script/*/
!/script/*/output/
!/script/*/output/*.mp4

# 一分钟系列：主题 / 工具 / 版本；仅默认收录说明、共享组件和正式成片。
!/script/one-minute/
!/script/one-minute/**/
!/script/one-minute/**/README.md
!/script/one-minute/catalog.json
!/script/one-minute/**/output/*.mp4
/script/one-minute/**/output/*.tmp.mp4
!/script/one-minute/shared/**
/script/*/output/*.tmp.mp4
!/script/shared/**
!/script/README.md
!/script/package.json

# RRF 可复用工程：保留画面源码、上游许可与字体，不收录依赖和逐帧缓存。
!/script/one-minute/_archive/rrf/codex/legacy/remotion/
!/script/one-minute/_archive/rrf/codex/legacy/remotion/src/
!/script/one-minute/_archive/rrf/codex/legacy/remotion/src/**
!/script/one-minute/_archive/rrf/codex/legacy/remotion/public/
!/script/one-minute/_archive/rrf/codex/legacy/remotion/public/huashu-fonts/
!/script/one-minute/_archive/rrf/codex/legacy/remotion/public/huashu-fonts/**
!/script/one-minute/_archive/rrf/codex/legacy/assets/
!/script/one-minute/_archive/rrf/codex/legacy/assets/references/
!/script/one-minute/_archive/rrf/codex/legacy/assets/references/visual-provenance.json
!/script/one-minute/_archive/rrf/codex/legacy/审片/
!/script/one-minute/_archive/rrf/codex/legacy/审片/*.md

node_modules
.env
.cache
.temp
package-lock.json
.DS_Store
images
*.log
*-vip.md

!/script/package-lock.json

