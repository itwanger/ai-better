# 视频项目只收录 output 顶层的最终成片；shared 保留源码。
# 放在通用忽略规则之前，避免放行 shared 下的依赖、密钥或缓存。
/script/**
!/script/*/
!/script/*/output/
!/script/*/output/*.mp4
/script/*/output/*.tmp.mp4
!/script/shared/**
!/script/README.md
!/script/package.json

# RRF 可复用工程：保留画面源码、上游许可与字体，不收录依赖和逐帧缓存。
!/script/one-minute-rrf/remotion/
!/script/one-minute-rrf/remotion/src/
!/script/one-minute-rrf/remotion/src/**
!/script/one-minute-rrf/remotion/public/
!/script/one-minute-rrf/remotion/public/huashu-fonts/
!/script/one-minute-rrf/remotion/public/huashu-fonts/**
!/script/one-minute-rrf/assets/
!/script/one-minute-rrf/assets/references/
!/script/one-minute-rrf/assets/references/visual-provenance.json
!/script/one-minute-rrf/审片/
!/script/one-minute-rrf/审片/*.md

node_modules
.env
.cache
.temp
package-lock.json
.DS_Store
images
*.log
*-vip.md

!/script/package-lock.json
