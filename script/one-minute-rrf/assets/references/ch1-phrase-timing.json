  "subtitles": [
    {
      "startFrame": 0,
      "endFrame": 91,
      "text": "当知识库同时使用关键词检索和向量检索时，",
      "beatId": 1
    },
    {
      "startFrame": 91,
      "endFrame": 139,
      "text": "两路各自返回了一份排名，",
      "beatId": 1
    },
    {
      "startFrame": 139,
      "endFrame": 192,
      "text": "怎么把它们合并成一份最终榜单？",
      "beatId": 1
    },
    {
      "startFrame": 192,
      "endFrame": 269,
      "text": "直接把原始分数相加是行不通的。",
      "beatId": 2
    },
    {
      "startFrame": 269,
      "endFrame": 336,
      "text": "向量检索的分数通常在 0 到 1 之间，",
      "beatId": 2
    },
    {
      "startFrame": 336,
      "endFrame": 401,
      "text": "而关键词检索的分数没有固定上限，",
      "beatId": 2
    },
    {
      "startFrame": 401,
      "endFrame": 477,
      "text": "直接相加会让总分被关键词检索主导。",
      "beatId": 2
    },
    {
      "startFrame": 477,
      "endFrame": 575,
      "text": "解决办法是 RRF，全称 Reciprocal Rank Fusion，",
      "beatId": 3
    },
    {
      "startFrame": 575,
      "endFrame": 620,
      "text": "中文叫倒数排名融合。",
      "beatId": 3
    },
    {
      "startFrame": 620,
      "endFrame": 697,
      "text": "它不看原始分数，只看名次。",
      "beatId": 4
    },
    {
      "startFrame": 697,
      "endFrame": 790,
      "text": "一篇文档在某一路排第 rank 名，名次从 1 开始算，",
      "beatId": 4
    },
    {
      "startFrame": 790,
      "endFrame": 901,
      "text": "就拿到 1 除以 k 加 rank 的分数，常数 k 通常取 60；",
      "beatId": 4
    },
    {
      "startFrame": 901,
      "endFrame": 970,
      "text": "如果这一路没有命中，就记 0 分。",
      "beatId": 4
    },
    {
      "startFrame": 970,
      "endFrame": 1023,
      "text": "来看一组示例排名。",
      "beatId": 5
    },
    {
      "startFrame": 1023,
      "endFrame": 1128,
      "text": "关键词检索的前三名是文档 A、文档 B、文档 C；",
      "beatId": 5
    },
    {
      "startFrame": 1128,
      "endFrame": 1208,
      "text": "向量检索的前两名是文档 B、文档 C，",
      "beatId": 5
    },
    {
      "startFrame": 1208,
      "endFrame": 1243,
      "text": "文档 A 没有命中。",
      "beatId": 5
    },
    {
      "startFrame": 1243,
      "endFrame": 1320,
      "text": "文档 A 只在关键词检索排第 1 名，",
      "beatId": 6
    },
    {
      "startFrame": 1320,
      "endFrame": 1414,
      "text": "得分是 1 除以 61 加 0，约为 0.0164。",
      "beatId": 6
    },
    {
      "startFrame": 1414,
      "endFrame": 1493,
      "text": "文档 B 在两路分别排第 2 名和第 1 名，",
      "beatId": 7
    },
    {
      "startFrame": 1493,
      "endFrame": 1589,
      "text": "得分是 1 除以 62 加 1 除以 61，约为 0.0325。",
      "beatId": 7
    },
    {
      "startFrame": 1589,
      "endFrame": 1672,
      "text": "文档 C 两路相加约为 0.0320。",
      "beatId": 7
    },
    {
      "startFrame": 1672,
      "endFrame": 1787,
      "text": "最终，被两路共同认可的文档 B 和文档 C 升到前两名，",
      "beatId": 8
    },
    {
      "startFrame": 1787,
      "endFrame": 1847,
      "text": "单路第一的文档 A 退到第 3 名。",
      "beatId": 8
    },
    {
      "startFrame": 1847,
      "endFrame": 1924,
      "text": "不过 RRF 只看名次、不读正文内容，",
      "beatId": 8
    },
    {
      "startFrame": 1924,
      "endFrame": 1984,
      "text": "通常用来做多路检索的快速粗排。",
      "beatId": 8
    }
  ],
